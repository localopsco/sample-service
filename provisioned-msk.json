{
  "dependencies": {
    "msk": {
      "clusters": [
        {
          "id": "events",
          "type": "provisioned",
          "version": "3.8.x",
          "instance_type": "kafka.t3.small",
          "broker_count": 3,
          "storage_gb": 10,
          "parameters": [
            { "name": "auto.create.topics.enable", "value": "true" },
            { "name": "default.replication.factor", "value": "3" },
            { "name": "min.insync.replicas", "value": "2" },
            { "name": "num.partitions", "value": "3" }
          ],
          "exports": {
            "KAFKA_NAME": "$name",
            "KAFKA_ARN": "$arn",
            "KAFKA_BROKERS": "$bootstrapBrokers",
            "KAFKA_PORT": "$port",
            "KAFKA_REGION": "$region",
            "KAFKA_SASL_MECHANISM": "$saslMechanism",
            "KAFKA_SECURITY_PROTOCOL": "$securityProtocol",
            "KAFKA_USERNAME": "$username",
            "KAFKA_PASSWORD": "$password",
            "KAFKA_PASSWORD_ARN": "$passwordArn"
          }
        }
      ]
    }
  }
}
