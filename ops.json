{
  "dependencies": {
    "rds": {
      "instances": [
        {
          "id": "mysqldb",
          "prefix": "mysqldb",
          "engine": "mysql",
          "version": "8.4",
          "storage_gb": 20,
          "instance_type": "db.t4g.small",
          "publicly_accessible": false,
          "managed_password": false,
          "exports": {
            "MYSQL_URL": "$dsn"
          }
        }
      ]
    },
    "elasticache": {
      "clusters": [
        {
          "id": "cache",
          "prefix": "cache",
          "engine": "redis",
          "version": "7.0",
          "instance_type": "cache.t4g.small",
          "num_nodes": 1,
          "exports": {
            "REDIS_ENDPOINT": "$endpoint",
            "REDIS_HOST": "$address",
            "REDIS_PORT": "$port"
          }
        }
      ]
    }
  }
}
